# ─────────────────────────────────────────────────────────────
# ViceCityMap environment configuration
# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser —
# never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Public base URL of the site (used for auth redirects, Stripe return URLs,
# sitemap and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API. When these are empty the app runs in
# "demo mode": the map uses bundled demonstration markers and
# accounts/payments are disabled.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy "anon") key — safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (or legacy "service_role") key — SERVER ONLY. Used exclusively by the
# payment webhook and admin user listing. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Payments ─────────────────────────────────────────────────
# Active payment provider. Currently supported: "stripe".
# Leave empty to disable checkout (the UI will say payments are unavailable).
PAYMENT_PROVIDER=
# Stripe → Developers → API keys. Use sk_test_… keys until your account is
# approved for live payments.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Optional: a pre-created one-time Price for USD 10.00. If empty, the price is
# defined inline at checkout. Either way the webhook re-validates amount/currency.
STRIPE_PRICE_ID=

# ── Map ──────────────────────────────────────────────────────
# Optional XYZ raster tile template for a licensed / custom map, e.g.
# https://cdn.example.com/tiles/{z}/{x}/{y}.png
# When empty, the bundled ORIGINAL PLACEHOLDER map is rendered.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=
NEXT_PUBLIC_MAP_MAX_ZOOM=7
